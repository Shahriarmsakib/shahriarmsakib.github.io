@article{rahman2025basin,
  abbr        = {HSJ},
  bibtex_show = {true},
  title       = {Basin-wide groundwater level forecasting in Kumamoto, Japan: integrating transfer learning with Long Short-term Memory Network},
  author      = {Rahman, A. T. M. Sakiur and Sakib, Shahriar M. and Reza, Md Kaykobad and Basak, Amiya and Hafiz, Khandaker Nusaiba and Islam, Md Shazid and Hosono, Takahiro},
  journal     = {Hydrological Sciences Journal},
  volume      = {70},
  number      = {14},
  pages       = {2590--2608},
  year        = {2025},
  publisher   = {Taylor \& Francis},
  doi         = {10.1080/02626667.2025.2530120},
  html        = {https://doi.org/10.1080/02626667.2025.2530120},
  code        = {https://github.com/Shahriarmsakib/LSTM-based-Time-Series-Forecasting-for-ground-water-Level},
  abstract    = {Deep learning models forecast groundwater levels accurately, but they are usually trained and tuned separately for every observation well, which does not scale to a whole basin. We pre-train a single LSTM on the basin-average groundwater series of the Kumamoto Groundwater Basin, Japan, and transfer it to each of seven observation wells by fine-tuning only its last layers (TL-LSTM). Compared with independently trained per-well LSTMs, the transferred models reach similar accuracy for one-, two- and three-month-ahead forecasts while needing far less training and calibration effort, making them practical for large-scale groundwater forecasting.},
  preview     = {hsj2025.jpg},
  selected    = {true}
}

@article{ashraf2024enhancing,
  abbr        = {Heliyon},
  bibtex_show = {true},
  title       = {Enhancing breast cancer classification via histopathological image analysis: Leveraging self-supervised contrastive learning and transfer learning},
  author      = {Ashraf, Faisal Bin and Alam, S. M. Maksudul and Sakib, Shahriar M.},
  journal     = {Heliyon},
  volume      = {10},
  number      = {2},
  pages       = {e24094},
  year        = {2024},
  publisher   = {Elsevier},
  doi         = {10.1016/j.heliyon.2024.e24094},
  html        = {https://doi.org/10.1016/j.heliyon.2024.e24094},
  code        = {https://github.com/Shahriarmsakib/Histopathological-image-classification-for-Breast-Cancer},
  abstract    = {We classify benign and malignant breast-cancer histopathology images from the BreakHis dataset at four magnification levels using two approaches. The first is a self-supervised contrastive scheme that starts from a small labeled subset and progressively adds confidently pseudo-labeled images. The second is a lightweight architecture that combines the early stages of ResNet50 with a naive Inception block, trained with several transfer-learning schedules. The hybrid reaches 98% accuracy at 40X and 200X and 94% at 100X and 400X with about 3.6 million parameters, less than half the size of the leading prior models in our comparison.},
  preview     = {heliyon2024.jpg},
  selected    = {true}
}
